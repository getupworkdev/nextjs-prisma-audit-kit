{
  "name": "nextjs-prisma-audit-kit",
  "version": "0.1.0",
  "description": "Reproducible audit tooling for existing Next.js + Prisma + WhatsApp Cloud API codebases",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
